# Copy this file to .env and fill in values locally.
# Never commit .env or real API keys.

HOST=127.0.0.1
PORT=8787

# Re:Link Gateway (OpenAI-compatible, Bearer authentication).
RELINK_BASE_URL=https://api.relink-gateway.biz.id/v1
RELINK_API_KEY=
# Confirm active model IDs with: npm run relink:check
RELINK_MODEL=deepseek-v4-pro
# Request timeout in milliseconds.
RELINK_TIMEOUT_MS=60000
